{
  "schemaVersion": 1,
  "name": "gemini-cli",
  "displayName": "gemini-cli",
  "role": "main",
  "requires": { "codingRuntime": ">=0.1.2 <1.0.0" },
  "env": { "GEMINI_CLI_HOME": "${STATE_DIR}/gemini" },
  "preflight": [{ "path": "${STATE_DIR}/gemini", "mode": "700" }],
  "config": { "emitter": { "type": "module", "path": "/opt/adapter/emit.mjs" } },
  "serve": { "surface": "terminal", "port": 8080, "originGuard": true },
  "terminal": {
    "tmuxSession": "gemini-cli",
    "launch": ["launch-gemini-cli"],
    "cwd": "${WORKDIR}",
    "wsPath": "/ws",
    "keepaliveSeconds": 25
  }
}
